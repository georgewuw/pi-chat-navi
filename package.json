{
	"name": "@georgewuw/pi-chat-navi",
	"version": "0.1.2",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"description": "pi coding agent extension：TUI 提问跳转面板（/questions）",
	"license": "MIT",
	"author": "georgewuw",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/georgewuw/pi-chat-navi.git"
	},
	"homepage": "https://github.com/georgewuw/pi-chat-navi#readme",
	"bugs": {
		"url": "https://github.com/georgewuw/pi-chat-navi/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"tui",
		"chat",
		"navigation"
	],
	"engines": {
		"node": ">=22.19"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc -p .",
		"test:compat": "node scripts/compat.mjs",
		"test": "node --test test/logic.test.ts test/contract.test.ts",
		"check": "pnpm run typecheck && pnpm test",
		"prepublishOnly": "pnpm run check"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.6.0",
		"@earendil-works/pi-tui": "^1.6.0",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
